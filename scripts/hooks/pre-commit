#!/bin/bash

# Pre-commit hook for url-shortener project
# Runs tests, formatting checks, and static analysis

set -e

echo "🔍 Running pre-commit checks..."

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${2}${1}${NC}"
}

# Check if Go is installed
if ! command -v go &> /dev/null; then
    print_status "❌ Go is not installed or not in PATH" "$RED"
    exit 1
fi

# 1. Check and fix code formatting
print_status "🎨 Checking code formatting..." "$YELLOW"
UNFORMATTED_FILES=$(gofmt -l .)
if [ -n "$UNFORMATTED_FILES" ]; then
    print_status "📝 Formatting the following files:" "$YELLOW"
    echo "$UNFORMATTED_FILES"
    go fmt ./...
    print_status "✅ Code formatting applied" "$GREEN"
    
    # Add the formatted files to the commit
    git add $UNFORMATTED_FILES
    print_status "📦 Formatted files added to commit" "$GREEN"
else
    print_status "✅ Code formatting is correct" "$GREEN"
fi

# 2. Run static analysis
print_status "🔎 Running static analysis..." "$YELLOW"
if go vet ./...; then
    print_status "✅ Static analysis passed" "$GREEN"
else
    print_status "❌ Static analysis failed" "$RED"
    exit 1
fi

# 3. Check for common issues
print_status "🔍 Checking for common issues..." "$YELLOW"

# Check for TODO/FIXME comments in staged files
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -n "$STAGED_GO_FILES" ]; then
    TODO_COUNT=$(grep -n "TODO\|FIXME" $STAGED_GO_FILES | wc -l || true)
    if [ "$TODO_COUNT" -gt 0 ]; then
        print_status "⚠️  Found $TODO_COUNT TODO/FIXME comments in staged files" "$YELLOW"
        grep -n "TODO\|FIXME" $STAGED_GO_FILES || true
        echo ""
    fi
fi

# 4. Check go.mod and go.sum are in sync
print_status "📦 Verifying module dependencies..." "$YELLOW"
if go mod verify; then
    print_status "✅ Module dependencies verified" "$GREEN"
else
    print_status "❌ Module verification failed" "$RED"
    exit 1
fi

# Check if go.mod needs tidying
if ! go mod tidy -diff &>/dev/null; then
    print_status "⚠️  go.mod needs tidying. Run 'go mod tidy'" "$YELLOW"
    # Don't fail the commit for this, just warn
fi

print_status "🎉 All pre-commit checks passed!" "$GREEN"
print_status "📝 Proceeding with commit..." "$YELLOW"